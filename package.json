{
  "name": "template-zero",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-fast, multilingual website + QR table menu template for restaurants, bars and cafes.",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "next-intl",
    "i18n",
    "restaurant",
    "qr-menu",
    "website-template"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "Kawe Longon",
    "url": "https://github.com/KaweAW"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaweAW/template-zero.git"
  },
  "bugs": {
    "url": "https://github.com/KaweAW/template-zero/issues"
  },
  "homepage": "https://github.com/KaweAW/template-zero#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate-content.ts",
    "qr": "tsx scripts/generate-qr.ts",
    "placeholders": "tsx scripts/generate-placeholders.ts",
    "screenshots": "tsx scripts/take-screenshots.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "predeploy": "npm run validate && npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
