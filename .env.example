# Reservation e-mails are sent with Resend (https://resend.com).
#
# Without RESEND_API_KEY:
#   - in development the form runs in "dry-run" mode (the request is logged to the console)
#   - in production the form returns an error (so you never lose a booking silently)
#   - set RESERVATION_DRY_RUN=true to force dry-run on a production build (used by the e2e tests).
#     Never set it on a live site: guests would see "sent" while nothing is delivered.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
# For quick tests you can use: "Trattoria da Marco <onboarding@resend.dev>"
RESERVATION_FROM_EMAIL=

# Where booking requests are delivered. Defaults to contact.email in data/config.json.
RESERVATION_TO_EMAIL=
